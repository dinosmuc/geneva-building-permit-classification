# env
.venv/
.env

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# reference material, not part of this repository
documentation/

# corpora — SITG terms plus size; data/splits/ manifests stay tracked
# data/raw keeps the pinned archive and live/<date>/ downloads local; source_manifest.json is
# the tracked lock that pins the archive
data/raw/*
!data/raw/.gitkeep
!data/raw/source_manifest.json
data/prepared/*
!data/prepared/.gitkeep

# experiment outputs — checkpoints, raw API responses, tracking stores
mlruns/
mlartifacts/
results/**/checkpoints/
results/**/raw_responses/
*.safetensors
*.bin
*.ckpt
